COMPOSE_PROJECT_NAME=infra-platform
TZ=America/Santo_Domingo
DOMAIN=example.com
ACME_EMAIL=admin@example.com

TRAEFIK_DASHBOARD_HOST=traefik.example.com
TRAEFIK_IMAGE=traefik:v3.7.9
TRAEFIK_LOG_LEVEL=INFO
TRAEFIK_DASHBOARD_AUTH=admin:$2y$05$CHANGE_THIS_BCRYPT_HASH

PORTAINER_HOST=portainer.example.com
UPTIME_HOST=uptime.example.com
PROMETHEUS_HOST=prometheus.example.com
GRAFANA_HOST=grafana.example.com
DOZZLE_HOST=logs.example.com

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME
PROMETHEUS_RETENTION=30d

TELEGRAM_BOT_TOKEN=CHANGE_ME
TELEGRAM_CHAT_ID=0

RESTIC_REPOSITORY=/repository
RESTIC_PASSWORD=CHANGE_ME
BACKUP_CRON=0 2 * * *
